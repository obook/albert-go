    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0011",
      "name": "Compteur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 450],
      "parameters": {
        "jsCode": "/* Un appel accepté par Albert compte pour son jour, rien d'autre n'est gardé. */\n/* ponytail: lecture puis écriture, deux appels simultanés peuvent n'en compter qu'un. */\nif ($input.first().json.statusCode !== 200) return [];\nreturn [{ json: { jour: new Date().toISOString().slice(0, 10) } }];"
      }
    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0015",
      "name": "Lire le jour",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1100, 450],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "albert-go-compteur" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [{ "keyName": "jour", "condition": "eq", "keyValue": "={{ $json.jour }}" }]
        },
        "limit": 1
      }
    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0021",
      "name": "Noter l'appel",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1320, 450],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": { "__rl": true, "mode": "name", "value": "albert-go-compteur" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [{ "keyName": "jour", "condition": "eq", "keyValue": "={{ $('Compteur').first().json.jour }}" }]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "jour": "={{ $('Compteur').first().json.jour }}", "appels": "={{ ($json.appels || 0) + 1 }}" },
          "matchingColumns": [],
          "schema": [
            { "id": "jour", "displayName": "jour", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "appels", "displayName": "appels", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0012",
      "name": "Webhook stats",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 700],
      "webhookId": "5b0f3c1e-7d2a-4e8b-a1c9-3f6e2d4b0003",
      "parameters": {
        "httpMethod": "GET",
        "path": "albert-go/stats",
        "responseMode": "responseNode",
        "options": {
