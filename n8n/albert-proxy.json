    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0013",
      "name": "Lire stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 700],
      "parameters": {
        "jsCode": "// Public : nombres seulement, ni empreintes ni origines.\nconst stats = $getWorkflowStaticData('global');\nconst jours = {};\nfor (const [d, j] of Object.entries(stats)) jours[d] = { appels: j.appels, utilisateurs: j.empreintes.length };\nreturn [{ json: jours }];"
      }
    },
