    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0013",
      "name": "Lire stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 700],
      "parameters": {
        "jsCode": "/* Public : appels par jour. */\nconst jours = {};\nfor (const { json: { jour, appels } } of $input.all()) if (jour) jours[jour] = { appels };\nreturn [{ json: jours }];"
      }
    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0022",
      "name": "Lire appels",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [220, 700],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "albert-go-compteur" },
        "returnAll": true
      }
    },
    {
      "id": "0d4c1f52-1a4e-4c3a-9f7e-2b1d6a8e0023",
      "name": "Purger",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [220, 850],
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": { "__rl": true, "mode": "name", "value": "albert-go-compteur" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "jour", "condition": "lt", "keyValue": "={{ new Date(Date.now() - 89 * 864e5).toISOString().slice(0, 10) }}" }
          ]
        },
        "options": {}
      }
    },
