# Configuration albert-go serveur, jamais dans le dépôt.
.env
# Modèle du .env versionné.
!.env-exemple
# Certificat HTTPS (serveur/certificat.py).
/cert.pem
/key.pem
# Journal du démarrage automatique (deploiement/demarrage.sh).
/albert-go.log*

# Playwright pour tests/ipad.webkit.js, installé sans être enregistré.
node_modules/
.venv/
__pycache__/
.pytest_cache/

# Fichiers intermédiaires de LuaLaTeX (docs/documentation.tex).
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
